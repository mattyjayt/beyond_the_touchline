# =============================================================================
#  Inside the Game - environment
#  Copy to .env (scripts/install.sh does this for you). One file, two sections:
#  LOCAL_* runs everything on this machine; CLOUD_* points at Azure services.
#  APP_MODE picks the active section. `scripts/run.sh --mode cloud` overrides
#  it for one run; `scripts/install.sh --mode cloud` persists it here.
# =============================================================================

# -----------------------------------------------------------------------------
#  SWITCH
# -----------------------------------------------------------------------------
APP_MODE=local                      # local | cloud

# -----------------------------------------------------------------------------
#  SHARED (both modes)
# -----------------------------------------------------------------------------
SIM_SEED=2026                       # synthetic generator seed (reproducibility)
REPLAY_SPEED=10                     # match seconds per wall-clock second
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
#  LOCAL
# -----------------------------------------------------------------------------
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8000
LOCAL_WEB_PORT=3000
LOCAL_API_BASE_URL=http://127.0.0.1:8000
LOCAL_DATABASE_URL=sqlite:///backend/data/inside_the_game.db   # relative to repo root
LOCAL_DATA_DIR=backend/data
LOCAL_AGENT_PROVIDER=claude_code    # claude_code (Agent SDK, Claude Code login) | rules

# -----------------------------------------------------------------------------
#  CLOUD (Azure) - left blank until infra provisioning writes these values
# -----------------------------------------------------------------------------
CLOUD_API_BASE_URL=                 # Azure Container Apps ingress URL
CLOUD_DATABASE_URL=                 # Azure SQL Database (free offer) connection string
CLOUD_DATA_DIR=                     # Azure Blob Storage container URL
CLOUD_AGENT_PROVIDER=foundry        # Azure AI Foundry Agent Service
CLOUD_REALTIME_URL=                 # Azure Web PubSub (optional fan-out)
CLOUD_FOUNDRY_ENDPOINT=
CLOUD_FOUNDRY_AGENT_ID=
CLOUD_APPINSIGHTS_CONNECTION_STRING=
